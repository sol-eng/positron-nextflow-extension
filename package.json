{
  "name": "positron-nextflow",
  "displayName": "Positron Nextflow",
  "description": "Nextflow language support, extended for Positron",
  "version": "0.1.0",
  "publisher": "posit",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelmayer2/positron-nextflow-extension.git"
  },
  "homepage": "https://nextflow.io",
  "bugs": {
    "url": "https://github.com/michaelmayer2/positron-nextflow-extension/issues"
  },
  "icon": "images/nextflow-icon-128x128.png",
  "keywords": [
    "bioinformatics",
    "nextflow",
    "nf-core",
    "pipelines",
    "computational biology",
    "scientific",
    "workflows"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:*.nf",
    "workspaceContains:nextflow.config",
    "onLanguage:nextflow-log",
    "onFileSystem:nextflow-log-filtered"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nextflow",
        "aliases": [
          "Nextflow",
          "nextflow"
        ],
        "extensions": [
          ".nf",
          ".nf.test"
        ],
        "firstLine": "^#!.*\\bnextflow\\b",
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/nextflow-icon.svg",
          "dark": "./images/nextflow-icon.svg"
        }
      },
      {
        "id": "nextflow-config",
        "aliases": [
          "Nextflow Config"
        ],
        "extensions": [
          ".config"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/nextflow-icon.svg",
          "dark": "./images/nextflow-icon.svg"
        }
      },
      {
        "id": "nextflow-log",
        "aliases": [
          "Nextflow Log"
        ],
        "filenamePatterns": [
          ".nextflow.log",
          ".nextflow.log.*",
          ".module.log",
          ".module.log.*"
        ],
        "icon": {
          "light": "./images/nextflow-log.svg",
          "dark": "./images/nextflow-log.svg"
        }
      },
      {
        "id": "nextflow-markdown-injection"
      }
    ],
    "grammars": [
      {
        "language": "nextflow",
        "scopeName": "source.nextflow",
        "path": "./syntaxes/nextflow.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.r": "r"
        }
      },
      {
        "scopeName": "nextflow.script.injection",
        "path": "./syntaxes/nextflow-script-injection.json",
        "injectTo": [
          "source.nextflow"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.r": "r"
        }
      },
      {
        "scopeName": "nextflow.interpolation.injection",
        "path": "./syntaxes/nextflow-interpolation-injection.json",
        "injectTo": [
          "source.nextflow"
        ]
      },
      {
        "language": "nextflow-config",
        "scopeName": "source.nextflow-config",
        "path": "./syntaxes/nextflow-config.tmLanguage.json"
      },
      {
        "language": "nextflow-log",
        "scopeName": "source.nextflow-log",
        "path": "./syntaxes/nextflow-log.tmLanguage.json"
      },
      {
        "scopeName": "source.nextflow-groovy",
        "path": "./syntaxes/groovy.tmLanguage.json"
      },
      {
        "language": "nextflow-markdown-injection",
        "scopeName": "markdown.nextflow.codeblock",
        "path": "./syntaxes/nextflow-markdown-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.nextflow": "nextflow"
        }
      }
    ],
    "commands": [
      {
        "command": "nextflow.languageServer.restart",
        "title": "Restart language server",
        "category": "Nextflow"
      },
      {
        "command": "nextflow.languageServer.stop",
        "title": "Stop language server",
        "category": "Nextflow"
      },
      {
        "command": "nextflow.log.filter.menu",
        "title": "Toggle log filters...",
        "category": "Nextflow Log",
        "icon": "$(list-filter)"
      },
      {
        "command": "nextflow.log.filter.toggle",
        "title": "Toggle log filtering",
        "category": "Nextflow Log"
      },
      {
        "command": "nextflow.seqera.goToCloud",
        "title": "Go to Seqera Cloud",
        "category": "Nextflow",
        "icon": "$(cloud)"
      },
      {
        "command": "nextflow.seqera.login",
        "title": "Login to Seqera Cloud",
        "category": "Nextflow",
        "icon": "$(sign-in)"
      },
      {
        "command": "nextflow.seqera.logout",
        "title": "Logout from Seqera Cloud",
        "category": "Nextflow",
        "icon": "$(sign-out)"
      },
      {
        "command": "nextflow.seqera.reloadWebview",
        "title": "Reload Seqera Webview",
        "category": "Nextflow",
        "icon": "$(refresh)"
      },
      {
        "command": "nextflow.positron.runSelection",
        "title": "Run Line or Selection in Console",
        "category": "Nextflow",
        "icon": "$(play)"
      },
      {
        "command": "nextflow.positron.runBlock",
        "title": "Run Script Block in Console",
        "category": "Nextflow",
        "icon": "$(run-all)"
      },
      {
        "command": "nextflow.positron.openInDataExplorer",
        "title": "Open in Data Explorer",
        "category": "Nextflow",
        "icon": "$(table)"
      },
      {
        "command": "nextflow.positron.runs.run",
        "title": "Run Pipeline...",
        "category": "Nextflow",
        "icon": "$(play)"
      },
      {
        "command": "nextflow.positron.runs.runAgain",
        "title": "Run Again",
        "category": "Nextflow",
        "icon": "$(debug-restart)"
      },
      {
        "command": "nextflow.positron.runs.resume",
        "title": "Resume",
        "category": "Nextflow",
        "icon": "$(debug-continue)"
      },
      {
        "command": "nextflow.positron.runs.stop",
        "title": "Stop Run",
        "category": "Nextflow",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nextflow.positron.runs.kill",
        "title": "Force Kill Run",
        "category": "Nextflow",
        "icon": "$(close)"
      },
      {
        "command": "nextflow.positron.runs.clean",
        "title": "Clean Work Directories",
        "category": "Nextflow",
        "icon": "$(trash)"
      },
      {
        "command": "nextflow.positron.runs.showOutput",
        "title": "Show Run Output",
        "category": "Nextflow",
        "icon": "$(output)"
      },
      {
        "command": "nextflow.positron.runs.openLog",
        "title": "Open .nextflow.log",
        "category": "Nextflow",
        "icon": "$(file)"
      },
      {
        "command": "nextflow.positron.runs.remove",
        "title": "Remove from List",
        "category": "Nextflow",
        "icon": "$(clear-all)"
      },
      {
        "command": "nextflow.positron.runs.cancelTask",
        "title": "Cancel Task",
        "category": "Nextflow",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nextflow.positron.runs.showTaskFiles",
        "title": "Show Task Files...",
        "category": "Nextflow",
        "icon": "$(files)"
      },
      {
        "command": "nextflow.positron.runs.copyWorkDir",
        "title": "Copy Work Directory Path",
        "category": "Nextflow",
        "icon": "$(copy)"
      },
      {
        "command": "nextflow.positron.runs.refresh",
        "title": "Refresh Pipeline Runs",
        "category": "Nextflow",
        "icon": "$(refresh)"
      },
      {
        "command": "nextflow.positron.runs.diagnostics",
        "title": "Show Run Diagnostics",
        "category": "Nextflow"
      },
      {
        "command": "nextflow.positron.runs.installNextflow",
        "title": "Install Nextflow",
        "category": "Nextflow"
      },
      {
        "command": "nextflow.positron.runs.openReport",
        "title": "Open Report",
        "category": "Nextflow",
        "icon": "$(graph)"
      },
      {
        "command": "nextflow.positron.runs.openTimeline",
        "title": "Open Timeline",
        "category": "Nextflow",
        "icon": "$(history)"
      },
      {
        "command": "nextflow.positron.runs.openDag",
        "title": "Open DAG",
        "category": "Nextflow",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nextflow.positron.runs.openTrace",
        "title": "Open Trace in Data Explorer",
        "category": "Nextflow",
        "icon": "$(table)"
      },
      {
        "command": "nextflow.positron.runs.debugTask",
        "title": "Debug Task in Console",
        "category": "Nextflow",
        "icon": "$(debug-console)"
      }
    ],
    "keybindings": [
      {
        "command": "nextflow.positron.runSelection",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "isPositron && editorTextFocus && editorLangId == nextflow"
      },
      {
        "command": "nextflow.positron.runBlock",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "isPositron && editorTextFocus && editorLangId == nextflow"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nextflow.log.filter.menu",
          "when": "resourceLangId == nextflow-log"
        },
        {
          "command": "nextflow.log.filter.toggle",
          "when": "resourceLangId == nextflow-log"
        },
        {
          "command": "nextflow.positron.runSelection",
          "when": "isPositron && editorLangId == nextflow"
        },
        {
          "command": "nextflow.positron.runBlock",
          "when": "isPositron && editorLangId == nextflow"
        },
        {
          "command": "nextflow.positron.openInDataExplorer",
          "when": "isPositron && resourceFilename =~ /(trace.*\\.txt|\\.(csv|tsv))$/i"
        },
        {
          "command": "nextflow.positron.runs.runAgain",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.resume",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.cancelTask",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.showTaskFiles",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.copyWorkDir",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.remove",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.clean",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.openLog",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.run",
          "when": "isPositron"
        },
        {
          "command": "nextflow.positron.runs.stop",
          "when": "isPositron"
        },
        {
          "command": "nextflow.positron.runs.kill",
          "when": "isPositron"
        },
        {
          "command": "nextflow.positron.runs.showOutput",
          "when": "isPositron"
        },
        {
          "command": "nextflow.positron.runs.refresh",
          "when": "isPositron"
        },
        {
          "command": "nextflow.positron.runs.diagnostics",
          "when": "isPositron"
        },
        {
          "command": "nextflow.positron.runs.installNextflow",
          "when": "isPositron"
        },
        {
          "command": "nextflow.positron.runs.openReport",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.openTimeline",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.openDag",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.openTrace",
          "when": "false"
        },
        {
          "command": "nextflow.positron.runs.debugTask",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "nextflow.positron.runSelection",
          "when": "isPositron && editorLangId == nextflow",
          "group": "navigation@0"
        },
        {
          "command": "nextflow.positron.runBlock",
          "when": "isPositron && editorLangId == nextflow",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "nextflow.positron.openInDataExplorer",
          "when": "isPositron && !explorerResourceIsFolder && resourceFilename =~ /(trace.*\\.txt|\\.(csv|tsv))$/i",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "command": "nextflow.positron.openInDataExplorer",
          "when": "isPositron && resourceFilename =~ /(trace.*\\.txt|\\.(csv|tsv))$/i",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "nextflow.seqera.reloadWebview",
          "when": "view == project || view == seqeraCloud",
          "group": "navigation@10"
        },
        {
          "command": "nextflow.seqera.logout",
          "when": "view == seqeraCloud && nextflow.isLoggedIn == true",
          "group": "navigation@10"
        },
        {
          "command": "nextflow.seqera.goToCloud",
          "when": "view == seqeraCloud && nextflow.isLoggedIn == true",
          "group": "navigation@10"
        },
        {
          "command": "nextflow.positron.runs.run",
          "when": "view == nextflow.runs",
          "group": "navigation@1"
        },
        {
          "command": "nextflow.positron.runs.refresh",
          "when": "view == nextflow.runs",
          "group": "navigation@2"
        },
        {
          "command": "nextflow.positron.runs.diagnostics",
          "when": "view == nextflow.runs",
          "group": "more@1"
        }
      ],
      "view/item/context": [
        {
          "command": "nextflow.positron.runs.stop",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(starting|running)$/",
          "group": "inline@1"
        },
        {
          "command": "nextflow.positron.runs.showOutput",
          "when": "view == nextflow.runs && viewItem =~ /^run\\./",
          "group": "inline@2"
        },
        {
          "command": "nextflow.positron.runs.runAgain",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "inline@0"
        },
        {
          "command": "nextflow.positron.runs.resume",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "inline@1"
        },
        {
          "command": "nextflow.positron.runs.stop",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(starting|running)$/",
          "group": "1_run@1"
        },
        {
          "command": "nextflow.positron.runs.kill",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(starting|running)$/",
          "group": "1_run@2"
        },
        {
          "command": "nextflow.positron.runs.runAgain",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "1_run@3"
        },
        {
          "command": "nextflow.positron.runs.resume",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "1_run@4"
        },
        {
          "command": "nextflow.positron.runs.showOutput",
          "when": "view == nextflow.runs && viewItem =~ /^run\\./",
          "group": "2_files@1"
        },
        {
          "command": "nextflow.positron.runs.openLog",
          "when": "view == nextflow.runs && viewItem =~ /^run\\./",
          "group": "2_files@2"
        },
        {
          "command": "nextflow.positron.runs.clean",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "3_manage@1"
        },
        {
          "command": "nextflow.positron.runs.remove",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "3_manage@2"
        },
        {
          "command": "nextflow.positron.runs.cancelTask",
          "when": "view == nextflow.runs && viewItem =~ /^task\\.(submitted|running)/",
          "group": "inline@1"
        },
        {
          "command": "nextflow.positron.runs.showTaskFiles",
          "when": "view == nextflow.runs && viewItem =~ /^task\\..*\\.workdir$/",
          "group": "1_task@1"
        },
        {
          "command": "nextflow.positron.runs.copyWorkDir",
          "when": "view == nextflow.runs && viewItem =~ /^task\\..*\\.workdir$/",
          "group": "1_task@2"
        },
        {
          "command": "nextflow.positron.runs.cancelTask",
          "when": "view == nextflow.runs && viewItem =~ /^task\\.(submitted|running)/",
          "group": "2_manage@1"
        },
        {
          "command": "nextflow.positron.runs.openReport",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "inline@2"
        },
        {
          "command": "nextflow.positron.runs.openReport",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "2_reports@1"
        },
        {
          "command": "nextflow.positron.runs.openTimeline",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "2_reports@2"
        },
        {
          "command": "nextflow.positron.runs.openDag",
          "when": "view == nextflow.runs && viewItem =~ /^run\\.(succeeded|failed|stopped|lost)$/",
          "group": "2_reports@3"
        },
        {
          "command": "nextflow.positron.runs.openTrace",
          "when": "view == nextflow.runs && viewItem =~ /^run\\./",
          "group": "2_reports@4"
        },
        {
          "command": "nextflow.positron.runs.debugTask",
          "when": "view == nextflow.runs && viewItem =~ /^task\\..*\\.workdir$/",
          "group": "inline@0"
        },
        {
          "command": "nextflow.positron.runs.debugTask",
          "when": "view == nextflow.runs && viewItem =~ /^task\\..*\\.workdir$/",
          "group": "1_task@0"
        }
      ],
      "editor/title": [
        {
          "command": "nextflow.positron.runs.run",
          "when": "isPositron && resourceLangId == nextflow && resourceFilename =~ /\\.nf$/",
          "group": "navigation@0"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "description": "Configuration for Nextflow language support",
      "properties": {
        "nextflow.completion.extended": {
          "type": "boolean",
          "default": false,
          "description": "Provide auto-completions from outside the current script. If an external completion is selected, it will be automatically included into the current script."
        },
        "nextflow.completion.maxItems": {
          "type": "integer",
          "default": 100,
          "description": "The maximum number of auto-completions to suggest at a time."
        },
        "nextflow.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging and debug information in hover hints."
        },
        "nextflow.errorReportingMode": {
          "type": "string",
          "enum": [
            "off",
            "errors",
            "warnings",
            "paranoid"
          ],
          "enumDescriptions": [
            "Disable all error reporting.",
            "Enable errors only.",
            "Enable errors and warnings.",
            "Enable errors, warnings, and additional messages for best practices."
          ],
          "default": "warnings",
          "description": "Set the desired level of error reporting."
        },
        "nextflow.files.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            ".lineage",
            ".nf-test",
            ".pixi",
            ".venv",
            "work"
          ],
          "description": "Folders that should be excluded when scanning the workspace for Nextflow files."
        },
        "nextflow.formatting.harshilAlignment": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use the [Harshil Alignment™️](https://nf-co.re/docs/contributing/code_editors_and_styling/harshil_alignment) when formatting Nextflow scripts and config files.\n\n*Note: not all rules are supported.*"
        },
        "nextflow.formatting.maheshForm": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Place process outputs at the end of the process body when formatting Nextflow scripts."
        },
        "nextflow.formatting.sortDeclarations": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Sort script declarations when formatting Nextflow scripts."
        },
        "nextflow.java.home": {
          "type": "string",
          "default": "",
          "markdownDescription": "Specify the folder path to the desired Java runtime. Equivalent to the `JAVA_HOME` environment variable, i.e. the Java binary should be located at `$JAVA_HOME/bin/java`. Use this setting if the extension cannot find Java automatically."
        },
        "nextflow.languageVersion": {
          "type": "string",
          "enum": [
            "26.10",
            "26.04",
            "25.10",
            "25.04",
            "24.10"
          ],
          "default": "26.10",
          "markdownDescription": "Nextflow language version to be used by the language server."
        },
        "nextflow.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable usage data to be sent to Seqera. See the welcome page for more information about what we do and do not collect."
        },
        "nextflow.log.debugOpacity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1,
          "default": 0.3,
          "markdownDescription": "Opacity applied to `DEBUG` and `TRACE` entries in `.nextflow.log` files. Set to `1.0` to disable dimming."
        },
        "nextflow.log.filter.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable filtering by log level. Logs are read-only when filtered."
        },
        "nextflow.log.filter.hiddenLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TRACE",
              "DEBUG",
              "INFO",
              "WARN",
              "ERROR"
            ]
          },
          "default": [],
          "uniqueItems": true,
          "markdownDescription": "Log levels to hide in `.nextflow.log` files when filtering is enabled. The file on disk is unchanged. Can be toggled per-file in the editor title bar."
        },
        "nextflow.log.filter.stripAnsi": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Remove ANSI escape codes (e.g. `\\u001b[0;32m`) from `.nextflow.log` files when filtering is enabled. The file on disk is unchanged. Can be toggled per-file in the editor title bar."
        },
        "nextflow.run.executable": {
          "type": "string",
          "default": "",
